# ── Obrigatórias ──────────────────────────────────────────────────────────

# String de conexão do PostgreSQL.
# Local (via docker-compose incluso): postgres://gravador:gravador@localhost:5432/gravador_de_tela
# Gerenciado (Render/Railway/Neon/Supabase): copie a "Connection string" do painel do provedor.
DATABASE_URL=postgres://gravador:gravador@localhost:5432/gravador_de_tela

# Segredo usado para assinar os tokens JWT. Gere um valor aleatório forte, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-valor-aleatorio-de-pelo-menos-32-caracteres

# ── Opcionais (têm valor padrão sensato) ─────────────────────────────────

NODE_ENV=development
PORT=4000
JWT_EXPIRES_IN=7d

# Origem permitida para CORS — deve ser a URL do frontend em produção.
CORS_ORIGIN=http://localhost:5173

# Tamanho máximo de upload de vídeo em bytes (padrão: 500 MB).
MAX_UPLOAD_BYTES=524288000

# Validade de um link de compartilhamento, em horas.
SHARE_LINK_TTL_HOURS=72

# ── Armazenamento de objetos (opcional) ──────────────────────────────────
# Sem estas variáveis, o backend salva vídeos sincronizados em ./uploads
# (disco local) — funciona out-of-the-box em desenvolvimento, mas não é
# adequado para múltiplas instâncias em produção.
#
# Preencha-as para usar um provedor compatível com S3: AWS S3, Cloudflare
# R2, Backblaze B2, MinIO, etc.

# S3_BUCKET=meu-bucket
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Necessário apenas para provedores não-AWS (Cloudflare R2, Backblaze B2, MinIO...)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Se o bucket tiver um domínio público/CDN configurado, informe aqui para usar URLs diretas
# em vez de URLs assinadas com expiração de 1 hora.
# S3_PUBLIC_URL=https://cdn.seu-dominio.com
